{
    "name": "@ringpublishing/mui-components-mcp",
    "description": "MCP server for Ring Publishing MUI Components documentation",
    "type": "module",
    "license": "LGPL-3.0-or-later",
    "repository": "ringpublishing/mui-components",
    "homepage": "https://design.ringpublishing.com/?path=/docs/introduction-mcp-server--docs",
    "bin": {
        "mui-components-mcp": "./dist/index.js"
    },
    "scripts": {
        "dev": "tsc -p tsconfig.json --watch",
        "build": "tsc -p tsconfig.json",
        "build:scripts": "tsc -p tsconfig.scripts.json",
        "generate-knowledge": "npm run build:scripts && node dist-scripts/scripts/generate-knowledge.js",
        "prebuild": "npm run generate-knowledge",
        "prepare": "npm run build",
        "start": "node dist/index.js"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.0.0",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@ringieraxelspringer/tsconfig": "^7.0.0",
        "@types/node": "^24.0.0",
        "typescript": "~5.1.0"
    },
    "engines": {
        "node": "^18||^20||^22||^24"
    }
}
